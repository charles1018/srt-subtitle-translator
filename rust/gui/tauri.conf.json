{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "srt-translator-gui",
  "version": "0.1.0",
  "identifier": "io.github.charles1018.srt-translator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SRT 字幕翻譯器",
        "width": 860,
        "height": 800,
        "minWidth": 640,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
